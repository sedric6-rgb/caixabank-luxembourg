# Base de données — soit DATABASE_URL, soit les variables individuelles ci-dessous
# (Railway fournit automatiquement MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE
# quand vous ajoutez le plugin "MySQL" à votre projet — vous n'avez rien à saisir vous-même
# une fois le plugin ajouté, Railway les injecte automatiquement.)
DATABASE_URL=mysql://user:password@host:3306/database

# Mot de passe pour se connecter à /admin
ADMIN_PASSWORD=changez-moi

# Chaîne aléatoire longue, utilisée pour signer les sessions admin.
# Générez-en une avec : openssl rand -hex 32
ADMIN_SESSION_SECRET=changez-moi-aussi
